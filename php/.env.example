# Copy this file to `.env` (same folder) and fill in your real mailbox
# details before uploading. `.env` is gitignored on purpose — never
# commit real credentials.
#
# Hostinger: hPanel → Emails → Email Accounts → create an account (e.g.
# admin@yourdomain.com) → use that address + its password below.
# Host: smtp.hostinger.com, Port: 465 (SSL) or 587 (STARTTLS).
#
# SMTP_USERNAME is just the "engine" that sends mail — MAIL_TO is where
# leads actually land. Keeping them separate means changing the sending
# mailbox's password later only requires updating SMTP_PASSWORD here;
# MAIL_TO doesn't need to change.

# --- SMTP (sending) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=admin@yourdomain.com
SMTP_PASSWORD=REPLACE_WITH_YOUR_MAILBOX_PASSWORD

# --- From / To ---
MAIL_FROM=admin@yourdomain.com
MAIL_FROM_NAME="Proposal Packages Barcelona"
MAIL_TO=contact@yourdomain.com
MAIL_TO_NAME=Erica

# --- Misc ---
SITE_URL=https://yourdomain.com
SITE_NAME="Proposal Packages Barcelona"

# Keep this in sync with WHATSAPP_NUMBER in src/lib/whatsapp.ts
WHATSAPP_NUMBER=34600000000
